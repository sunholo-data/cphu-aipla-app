"use client";

// SCAFFOLD: __PASCAL__ workbench snapshot hook.
// Generated by scripts/new-workbench-skill.sh. This is the shared
// source of truth both the sim iframe and the React workbench surfaces
// (quiz, graph, pickers) feed via reportEvent. See
// .claude/skills/mcp-app-artefact/SKILL.md "Shared snapshot hook".
//
// TODO: replace the snapshot fields + event union below with your
// artefact's real vocabulary. Keep the reportEvent / POST / card-
// dispatch shape — that's the plumbing you don't want to re-derive.

import { useCallback, useEffect, useRef, useState } from "react";

import { useHumanToolEvents } from "@/hooks/useHumanToolEvents";
import { fetchWithAuth } from "@/lib/apiClient";

export interface __PASCAL__Snapshot {
  lastEvent: string;
  // TODO: add the fields the agent should see, e.g.
  //   currentTopic: string | null;
  //   lastRun: { ... } | null;
}

// TODO: one variant per pedagogically meaningful event your surfaces
// produce. Prefix every kind with "__NAME__.".
export type __PASCAL__Event =
  | { kind: "__NAME__.example"; value: number };

const INITIAL: __PASCAL__Snapshot = {
  lastEvent: "",
};

export interface Use__PASCAL__Snapshot {
  snapshot: __PASCAL__Snapshot;
  reportEvent: (evt: __PASCAL__Event) => void;
}

export function use__PASCAL__Snapshot(
  sessionId: string | null,
): Use__PASCAL__Snapshot {
  const humanToolEvents = useHumanToolEvents();
  const [snapshot, setSnapshot] = useState<__PASCAL__Snapshot>(INITIAL);
  const snapshotRef = useRef<__PASCAL__Snapshot>(snapshot);
  snapshotRef.current = snapshot;
  const sessionIdRef = useRef(sessionId);
  sessionIdRef.current = sessionId;

  const pushSnapshotRequest = useCallback(
    (snap: __PASCAL__Snapshot, latestKind: string): Promise<Response> | null => {
      const sid = sessionIdRef.current;
      if (!sid) return null;
      const body = {
        serverId: "__NAME__",
        toolName: "state",
        structuredContent: { ...snap, lastEvent: latestKind },
      };
      return fetchWithAuth(`/api/proxy/api/sessions/${sid}/iframe-context`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
    },
    [],
  );

  const reportEvent = useCallback(
    (evt: __PASCAL__Event) => {
      const prev = snapshotRef.current;
      const next: __PASCAL__Snapshot = { ...prev, lastEvent: evt.kind };
      let pushedLabel: string | null = null;

      switch (evt.kind) {
        case "__NAME__.example": {
          // TODO: mutate `next` from evt; set pushedLabel for a chat
          // card, or leave null for a silent push.
          break;
        }
      }

      setSnapshot(next);
      snapshotRef.current = next;

      const req = pushSnapshotRequest(next, evt.kind);
      if (req) {
        if (pushedLabel) {
          humanToolEvents.dispatch({ label: pushedLabel, push: () => req });
        } else {
          void req.catch(() => {});
        }
      }
    },
    [pushSnapshotRequest, humanToolEvents],
  );

  // Catch-up push when sessionId arrives after the student interacted.
  useEffect(() => {
    if (!sessionId) return;
    const snap = snapshotRef.current;
    if (snap.lastEvent) {
      const req = pushSnapshotRequest(snap, snap.lastEvent || "catch-up");
      if (req) void req.catch(() => {});
    }
  }, [sessionId, pushSnapshotRequest]);

  return { snapshot, reportEvent };
}
