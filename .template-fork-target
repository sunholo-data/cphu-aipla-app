# Which template this fork tracks, and where it forked from.
#
# Read by scripts/check-upstream-routing.sh and scripts/port-up.sh.
#
# UPSTREAM_REPO is platform-source, NOT sunholo-data/ai-protocol-platform.
# The public template is GENERATED by a force-push of a fresh single-commit
# history (see the upstream's refresh-public-template.sh), so a PR opened
# against it is destroyed by the next refresh. platform-source is the source
# of truth; changes reach the public template from there.
#
# FORK_BASE is this repo's root commit — a squashed "Initial commit" of the
# public template taken on 2026-05-19. It shares no git ancestor with upstream,
# so `git merge-base` finds nothing; FORK_BASE is the merge base in substance
# and the routing check uses it as one.

UPSTREAM_REPO=https://github.com/sunholo-data/platform-source.git
UPSTREAM_BRANCH=main
FORK_BASE=160c9fe

# Last upstream commit reconciled against, and when. Update when you port up.
UPSTREAM_PINNED=b322f55d
PINNED_DATE=2026-09-08
