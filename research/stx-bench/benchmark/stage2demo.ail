module benchmark/stage2demo

-- Stage-2 LIVE demo runner. Loops a small model panel over self-contained probes
-- (NOT the gated corpus), calling std/ai.step with a DIFFERENT model string per
-- call — the native per-call tier-descent primitive. Writes results in the exact
-- shape benchmark/matrix.ail consumes, so the full Stage-2 pipeline is proven on
-- real cross-model data, cheaply.
--
-- The real corpus runner (over items.jsonl question_text, full bench-config panel)
-- is the same shape at scale, and stays gated (spend + question_text + VERIFY.md).
--
-- Free wiring check: ailang run --ai-stub --caps IO,FS,AI --entry main benchmark/stage2demo.ail
-- Real (~4 calls):   ailang run --ai gemini-2-5-flash --caps IO,FS,AI --entry main benchmark/stage2demo.ail

import benchmark/keyparse (Numeric, Symbolic, NeedsReview, extractFacit)
import benchmark/grader (Expected, gradeNumeric, verdictLabel)
import benchmark/solver (systemPrompt, userMessage)
import std/ai (Message, StepResult, AIError, step)
import std/fs (writeFile, mkdirAll)
import std/result (Result, Ok, Err)
import std/list (length)

type Probe = {
  item_id: string, set: string, subq: string, topics: [string],
  question: string, expected: Expected
}

pure func probes() -> [Probe] =
  [ { item_id: "demo-F", set: "demo", subq: "1", topics: ["mechanics-forces"],
      question: "En genstand med massen m = 2,0 kg har accelerationen a = 3,0 m/s^2. Beregn den resulterende kraft F.",
      expected: { value: 6.0, unit: "N", tolerance_rel: 0.05 } },
    { item_id: "demo-Ek", set: "demo", subq: "2", topics: ["energy"],
      question: "Beregn den kinetiske energi for en genstand med masse m = 4,0 kg og fart v = 5,0 m/s.",
      expected: { value: 50.0, unit: "J", tolerance_rel: 0.05 } } ]

-- Panel: per-call model strings. IMPORTANT — these must be provider API names
-- (dots: "gemini-2.5-flash"), NOT the friendly --ai names (dashes). The per-call
-- step() path does not apply models.yml friendly->api resolution, and per-call
-- routing stays within the bound handler's provider (cross-vendor needs OpenRouter).
pure func panel() -> [string] = ["gemini-2.5-flash", "gemini-2.5-pro"]

func solve(model: string, q: string) -> Result[StepResult, AIError] ! {AI} {
  let msgs = [
    { role: "system", content: systemPrompt(), tool_calls: [], tool_call_id: "", images: [] },
    { role: "user",   content: userMessage(q), tool_calls: [], tool_call_id: "", images: [] }
  ];
  step(model, msgs, [])
}

pure func quoteJoin(xs: [string]) -> string =
  match xs {
    [] => "",
    x :: rest => match rest { [] => "\"${x}\"", _ => "\"${x}\",${quoteJoin(rest)}" }
  }

pure func resultLine(p: Probe, model: string, verdict: string, inTok: int, outTok: int) -> string =
  "{\"item_id\":\"${p.item_id}\",\"set\":\"${p.set}\",\"subq\":\"${p.subq}\",\"topics\":[${quoteJoin(p.topics)}],\"model\":\"${model}\",\"verdict\":\"${verdict}\",\"in_tokens\":${show(inTok)},\"out_tokens\":${show(outTok)}}"

func runCell(model: string, p: Probe) -> string ! {AI, IO} {
  match solve(model, p.question) {
    Err(e) => {
      println("  ${model}  ${p.item_id}  AI-ERROR ${e.code} (retryable=${show(e.retryable)})");
      ""
    },
    Ok(r) => {
      let verdict =
        match extractFacit(r.message.content) {
          Numeric(v, u)  => verdictLabel(gradeNumeric(p.expected, v, u)),
          Symbolic       => "ambiguous",
          NeedsReview(_) => "ambiguous"
        };
      println("  ${model}  ${p.item_id}  ${verdict}  (in=${show(r.input_tokens)} out=${show(r.output_tokens)})");
      resultLine(p, model, verdict, r.input_tokens, r.output_tokens)
    }
  }
}

func runProbes(model: string, ps: [Probe]) -> string ! {AI, IO} =
  match ps {
    [] => "",
    p :: rest => "${runCell(model, p)}\n${runProbes(model, rest)}"
  }

func runPanel(ms: [string]) -> string ! {AI, IO} =
  match ms {
    [] => "",
    m :: rest => "${runProbes(m, probes())}${runPanel(rest)}"
  }

export func main() -> () ! {AI, IO, FS} {
  println("STX Stage-2 LIVE demo — panel x probes (per-call model selection)");
  println("");
  let lines = runPanel(panel());
  mkdirAll("runs/stage2");
  writeFile("runs/stage2/results.jsonl", lines);
  println("");
  println("wrote runs/stage2/results.jsonl — now: ailang run --caps IO,FS --entry main benchmark/matrix.ail")
}
