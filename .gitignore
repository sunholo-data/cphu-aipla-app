.dev-logs/

# Locked agent worktrees from parallel sub-agent execution. The harness
# manages these; they're never committed and shouldn't block sanitize.
.claude/worktrees/

# Terraform local state + provider plugins (never commit — provider binaries are >100MB)
**/.terraform/
*.tfstate
*.tfstate.*
demo-captures/

# Copyrighted literature — private working references (repo is public on
# GitHub). Keep the citation README.md tracked; never the PDFs or their
# full-text parsed extracts. See docs/literature/tp-framework/README.md.
docs/literature/**/*.pdf
docs/literature/**/parsed/
